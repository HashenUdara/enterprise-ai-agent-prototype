# Neon pooled or direct PostgreSQL connection string.
# Keep the real value in .env.local and in the Vercel project environment.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Shared secret required by the remote MCP endpoint.
MCP_BEARER_TOKEN=replace-with-a-long-random-secret

# Comma-separated origin hostnames allowed when a client sends Origin.
# Non-browser MCP clients normally omit Origin. Add the deployed app hostname.
MCP_ALLOWED_ORIGINS=localhost,127.0.0.1
